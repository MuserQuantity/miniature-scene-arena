COMPOSE_PROJECT_NAME=miniature-scene-arena

TRAEFIK_ENABLED=true
TRAEFIK_DOMAIN=scene.example.com
TRAEFIK_NETWORK=traefik
TRAEFIK_ROUTER_NAME=${COMPOSE_PROJECT_NAME}
TRAEFIK_ENTRYPOINTS=websecure
TRAEFIK_TLS=true
TRAEFIK_CERT_RESOLVER=letsencrypt
TRAEFIK_MIDDLEWARES=

SITE_URL=https://${TRAEFIK_DOMAIN}

SCENE_API_KEY=
SCENE_API_URL=${SITE_URL}
